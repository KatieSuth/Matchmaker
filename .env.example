# Copy to ".env" and fill in your real values: cp .env.example .env

# ── Image publishing (Docker Hub) ─────────────────────────────
# IMAGE is the base repository (registry/namespace/name). Each service appends
# its suffix: ${IMAGE}-api:${VERSION} and ${IMAGE}-frontend:${VERSION}.
# Log in first with: docker login
# Then publish with: make publish IMAGE=youruser/matchmaker VERSION=v1.0.0
IMAGE=your-dockerhub-username/matchmaker
VERSION=latest

# ── Build versions ────────────────────────────────────────────
# These pin the base images used in the multi-stage Dockerfiles.
# Check for latest releases at:
#   Go:       https://go.dev/dl/
#   Node:     https://nodejs.org/en/download
#   Postgres: https://hub.docker.com/_/postgres/tags
#   Caddy:    https://hub.docker.com/_/caddy/tags
GO_VERSION=1.25
NODE_VERSION=20
POSTGRES_VERSION=18-alpine
CADDY_VERSION=2-alpine

# ── Ports ─────────────────────────────────────────────────────
# API_PORT / FRONTEND_PORT are internal container ports.
# HTTP_PORT / HTTPS_PORT are the ports Caddy binds on the host.
API_PORT=8080
FRONTEND_PORT=3000
DB_PORT=5432
HTTP_PORT=80
HTTPS_PORT=443

# ── Networking ────────────────────────────────────────────────
# Subnet for the internal Docker bridge network shared by all services.
# Change this if it conflicts with an existing network on your host.
APP_SUBNET=172.20.0.0/16

# ── Domain ────────────────────────────────────────────────────
# Your domain. This can be localhost
# Each derived var is listed below.
# Uncomment one only to override its default:
#   FRONTEND_URL                = https://${DOMAIN}
#   NEXT_PUBLIC_API_URL         = https://${DOMAIN}/api
#   NEXT_PUBLIC_FRONTEND_DOMAIN = ${DOMAIN}
#   COOKIE_DOMAIN               = ${DOMAIN}
DOMAIN=your.app

# ── API runtime ───────────────────────────────────────────────
# "release" in production,
# "debug" in development.
GIN_MODE=release

# Postgres credentials — used by both the API and the db container.
# POSTGRES_PASSWORD — generate a strong random password
POSTGRES_USER=matchmaker
POSTGRES_PASSWORD=replace-with-output-of--openssl-rand-hex-32           # openssl rand -hex 32
POSTGRES_DB=matchmaker
# DATABASE_URL_TESTS — used by the Go test suite for integration tests.
# DATABASE_URL_TESTS=postgres://matchmaker:replace-with-password@localhost:5432/matchmaker_test?sslmode=disable

# Secure cookie signing & encryption keys used by gorilla/securecookie.
# COOKIE_HASH_KEY   — signs the cookie value (HMAC-SHA256)
# COOKIE_ENCRYPT_KEY — encrypts the cookie value (AES-256)
COOKIE_HASH_KEY=replace-with-output-of--openssl-rand-hex-32             # openssl rand -hex 32
COOKIE_ENCRYPT_KEY=replace-with-another-output-of--openssl-rand-hex-32  # openssl rand -hex 32
# COOKIE_DOMAIN is derived from DOMAIN; uncomment to override.
# COOKIE_DOMAIN=your.app

# JWT signing secret used for refresh tokens — keep this private.
#   Generate: openssl rand -hex 32
# REFRESH_EXPIRE_LIMIT: how long (in seconds) a refresh token stays valid.
#   604800 = 7 days. Reduce for stricter session security.
JWT_SECRET=replace-with-output-of--openssl-rand-hex-32                  # openssl rand -hex 32
REFRESH_EXPIRE_LIMIT=604800

# Discord OAuth2 credentials.
# 1. Go to https://discord.com/developers/applications → New Application.
# 2. Open OAuth2 → General: copy the Client ID and reset/copy the Client Secret.
# 3. Under OAuth2 → Redirects: register https://${DOMAIN}/api/auth/discord_redirect
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# DISCORD_REDIRECT_URI=https://your.app/api/auth/discord_redirect   # Derived from DOMAIN; uncomment to override.
# DISCORD_API_URL defaults to https://discord.com/api;              # Uncomment only if you proxy it.
# DISCORD_API_URL=https://discord.com/api

# Allowed CORS origin
# FRONTEND_URL=https://your.app  # Derived from DOMAIN; uncomment to override.

# ── Matchmaking fairness thresholds ───────────────────────────
# These tune how strictly the matchmaker enforces skill balance.
# Calibrated for FAIRNESS_REFERENCE_TIER_COUNT tiers — adjust together if you
# change the number of tiers in your rating system.
FAIRNESS_OUTLIER_GAP=6
FAIRNESS_TEAM_SEPARATION=3
FAIRNESS_REFERENCE_TIER_COUNT=25

# ── Frontend runtime / Next.js build args ─────────────────────
# NEXT_PUBLIC_API_URL and NEXT_PUBLIC_FRONTEND_DOMAIN are derived from DOMAIN by
# Compose (baked in at build time AND read at runtime). Uncomment to override.
# NODE_ENV — set to "development" when running outside Docker for hot-reload.
# NEXT_PUBLIC_API_URL=https://your.app/api
# NEXT_PUBLIC_FRONTEND_DOMAIN=your.app
NODE_ENV=production