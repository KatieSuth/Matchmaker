# Root .env consumed by Docker Compose for variable interpolation.
# Copy to ".env" and adjust as needed: cp .env.example .env
#
# These values configure image names, build versions, ports, networking,
# and the frontend public build args. Runtime application secrets still live
# in ./backend/.env and ./frontend/.env (loaded via env_file).

# ── Image publishing (Docker Hub) ─────────────────────────────
# IMAGE is the base repository (registry/namespace/name). Each service appends
# its suffix, so the pushed images are ${IMAGE}-api:${VERSION} and
# ${IMAGE}-frontend:${VERSION}. Example: IMAGE=docker.io/youruser/matchmaker
IMAGE=your-dockerhub-username/matchmaker
VERSION=latest

# Compose project name (also used as the container_name prefix)
COMPOSE_PROJECT_NAME=matchmaker

# ── Build versions ────────────────────────────────────────────
GO_VERSION=1.25
NODE_VERSION=20
POSTGRES_VERSION=18-alpine
CADDY_VERSION=2-alpine

# ── Ports ─────────────────────────────────────────────────────
API_PORT=8080
FRONTEND_PORT=3000
DB_PORT=5432
HTTP_PORT=80
HTTPS_PORT=443

# ── Networking ────────────────────────────────────────────────
APP_SUBNET=172.20.0.0/16

# ── Frontend public build args ──
NEXT_PUBLIC_API_URL=https://matchmaker.localhost/api
NEXT_PUBLIC_FRONTEND_DOMAIN=matchmaker.localhost
NEXT_PUBLIC_COOKIE_AUTH_EXPIRE_LIMIT=604800
