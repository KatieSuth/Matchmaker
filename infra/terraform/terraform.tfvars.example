# Copy to terraform.tfvars (gitignored). Fill after Phase 0 account setup (see infra/README.md)
# Account/signup is MANUAL — this file only configures Terraform against existing accounts.
#
# Secrets belong HERE (not in the repo). Generate hex app keys with:
#   make gen-keys
#   # or: openssl rand -hex 32
# DB passwords / origin-verify can be any strong secret (openssl rand -hex 32 is fine).
# Values still end up in Terraform state (GCS); keep the state bucket private.

project_id         = "your-gcp-project-id"
region             = "us-central1"
domain             = "matchmaker.games"
billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
alert_email        = "you@example.com"

cloudflare_account_id = "your-cloudflare-account-id"
cloudflare_zone_id    = "your-cloudflare-zone-id"
cloudflare_api_token  = "your-cloudflare-api-token"

discord_client_id     = "your-discord-client-id"
discord_client_secret = "your-discord-client-secret"

# DB passwords (required). Three separate secrets — do not reuse across roles.
# Cutover: leave db_roles_bootstrapped=false → apply → make gcp-db-bootstrap →
# set db_roles_bootstrapped=true → apply again. See infra/README.md.
db_admin_password     = "replace-with-strong-password" # postgres admin (Studio / bootstrap)
db_migrator_password  = "replace-with-strong-password" # matchmaker_migrator (goose Job)
db_app_password       = "replace-with-strong-password" # matchmaker_app (API); also legacy matchmaker until bootstrapped
db_roles_bootstrapped = false

# App secrets (required)
jwt_secret              = "replace-with-64-hex-chars"             # openssl rand -hex 32
cookie_hash_key         = "replace-with-64-hex-chars"             # openssl rand -hex 32
cookie_encrypt_key      = "replace-with-64-hex-chars"             # openssl rand -hex 32
api_link_encryption_key = "replace-with-64-hex-chars"             # openssl rand -hex 32; do not reuse cookie_encrypt_key
api_link_encryption_key_id = "1"
# api_link_encryption_previous_keys = ""                          # optional: "1:<old-64-hex>" after rotating
origin_verify_secret    = "replace-with-strong-secret"            # openssl rand -hex 32

# Optional — leave empty to disable Sentry on that service
sentry_dsn_api      = ""
sentry_dsn_frontend = ""
